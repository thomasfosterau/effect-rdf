{
  "name": "@thomasfosterau/effect-rdfxml",
  "version": "0.0.0",
  "description": "RDF 1.2 XML Syntax (RDF/XML) parser and serializer for effect-rdf",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
  },
  "scripts": {
    "bench": "node --experimental-strip-types --no-warnings bench/xml.ts",
    "build": "vp pack"
  },
  "dependencies": {
    "@thomasfosterau/effect-rdf": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "effect": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "catalog:",
    "effect": "catalog:"
  }
}
