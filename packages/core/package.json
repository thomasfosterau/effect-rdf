{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-rdf",
  "version": "0.0.0",
  "description": "Effect-idiomatic RDF 1.2, RDF Schema and RDF-star data model, with an RDF/JSON codec",
  "keywords": [
    "effect",
    "rdf",
    "rdf-json",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./rdfjson": "./src/rdfjson/index.ts",
    "./rdfjson/*": "./src/rdfjson/*.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./rdfjson": {
        "types": "./dist/rdfjson/index.d.mts",
        "default": "./dist/rdfjson/index.mjs"
      },
      "./rdfjson/*": {
        "types": "./dist/rdfjson/*.d.mts",
        "default": "./dist/rdfjson/*.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
