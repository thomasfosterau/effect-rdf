{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-rdf",
  "version": "0.0.0",
  "description": "Effect-idiomatic RDF 1.2, RDF Schema and RDF-star data model, with RDF/JSON, CSV on the Web (CSVW) and a SHACL Core validator",
  "keywords": [
    "csv",
    "csvw",
    "effect",
    "rdf",
    "rdf-json",
    "shacl",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./csvw": "./src/csvw/index.ts",
    "./csvw/*": "./src/csvw/*.ts",
    "./rdfjson": "./src/rdfjson/index.ts",
    "./rdfjson/*": "./src/rdfjson/*.ts",
    "./shacl": "./src/shacl/index.ts",
    "./shacl/*": "./src/shacl/*.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./csvw": {
        "types": "./dist/csvw/index.d.mts",
        "default": "./dist/csvw/index.mjs"
      },
      "./csvw/*": {
        "types": "./dist/csvw/*.d.mts",
        "default": "./dist/csvw/*.mjs"
      },
      "./rdfjson": {
        "types": "./dist/rdfjson/index.d.mts",
        "default": "./dist/rdfjson/index.mjs"
      },
      "./rdfjson/*": {
        "types": "./dist/rdfjson/*.d.mts",
        "default": "./dist/rdfjson/*.mjs"
      },
      "./shacl": {
        "types": "./dist/shacl/index.d.mts",
        "default": "./dist/shacl/index.mjs"
      },
      "./shacl/*": {
        "types": "./dist/shacl/*.d.mts",
        "default": "./dist/shacl/*.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
