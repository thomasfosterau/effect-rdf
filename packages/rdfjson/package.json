{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-rdfjson",
  "version": "0.0.0",
  "description": "RDF/JSON parser, serializer and Effect Schemas for effect-rdf",
  "keywords": [
    "effect",
    "rdf",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/rdfjson#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/rdfjson"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-rdf": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
