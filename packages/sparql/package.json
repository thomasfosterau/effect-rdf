{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-sparql",
  "version": "0.0.0",
  "description": "Effect-idiomatic SPARQL 1.1 / 1.2: parser, algebra, query engine, results formats, a typed query builder, a SPARQL Protocol / Graph Store server and client, SHACL-SPARQL, and knowledge-graph tools for effect/ai",
  "keywords": [
    "ai",
    "effect",
    "mcp",
    "rdf",
    "shacl",
    "sparql",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/sparql#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/sparql"
  },
  "bin": {
    "effect-sparql-server": "./bin/effect-sparql-server.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai/index.ts",
    "./ai/*": "./src/ai/*.ts",
    "./shacl": "./src/shacl/index.ts",
    "./shacl/*": "./src/shacl/*.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./ai": {
        "types": "./dist/ai/index.d.mts",
        "default": "./dist/ai/index.mjs"
      },
      "./ai/*": {
        "types": "./dist/ai/*.d.mts",
        "default": "./dist/ai/*.mjs"
      },
      "./shacl": {
        "types": "./dist/shacl/index.d.mts",
        "default": "./dist/shacl/index.mjs"
      },
      "./shacl/*": {
        "types": "./dist/shacl/*.d.mts",
        "default": "./dist/shacl/*.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "bench": "node --experimental-strip-types --no-warnings bench/results-text.ts && node --experimental-strip-types --no-warnings bench/parser.ts",
    "start": "node --experimental-transform-types --no-warnings bin/effect-sparql-server.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@thomasfosterau/effect-jsonld": "workspace:*",
    "@thomasfosterau/effect-n3": "workspace:*",
    "@thomasfosterau/effect-ntriples": "workspace:*",
    "@thomasfosterau/effect-rdf": "workspace:*",
    "@thomasfosterau/effect-rdfxml": "workspace:*",
    "@thomasfosterau/effect-turtle": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "catalog:peers",
    "effect": "catalog:platform-node-peers"
  },
  "engines": {
    "node": ">=22"
  }
}
