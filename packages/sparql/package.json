{
  "name": "@thomasfosterau/effect-sparql",
  "version": "0.0.0",
  "description": "Effect-idiomatic SPARQL 1.1 / 1.2: parser, algebra, query engine, results formats and a typed query builder",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@thomasfosterau/effect-rdf": "workspace:*",
    "@thomasfosterau/effect-rdfxml": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-ntriples": "workspace:*",
    "@thomasfosterau/effect-turtle": "workspace:*",
    "effect": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
