{
  "name": "@thomasfosterau/effect-sparql-server",
  "version": "0.0.0",
  "description": "Effect-idiomatic SPARQL 1.1 Protocol and Graph Store HTTP Protocol server",
  "license": "MIT",
  "bin": {
    "effect-sparql-server": "./bin/effect-sparql-server.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "start": "node --experimental-transform-types --no-warnings bin/effect-sparql-server.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@thomasfosterau/effect-jsonld": "workspace:*",
    "@thomasfosterau/effect-n3": "workspace:*",
    "@thomasfosterau/effect-ntriples": "workspace:*",
    "@thomasfosterau/effect-rdf": "workspace:*",
    "@thomasfosterau/effect-rdfjson": "workspace:*",
    "@thomasfosterau/effect-rdfxml": "workspace:*",
    "@thomasfosterau/effect-sparql": "workspace:*",
    "@thomasfosterau/effect-turtle": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
