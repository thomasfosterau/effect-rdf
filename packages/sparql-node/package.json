{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-sparql-node",
  "version": "0.3.0",
  "description": "The Node side of @thomasfosterau/effect-rdf/sparql: a SPARQL 1.1 Protocol / Graph Store server on node:http, its command-line launcher, and the typed SparqlApi HttpApi definition, server and client",
  "keywords": [
    "effect",
    "http-api",
    "rdf",
    "sparql",
    "sparql-protocol",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/sparql-node#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/sparql-node"
  },
  "bin": {
    "effect-sparql-server": "./bin/effect-sparql-server.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-transform-types --no-warnings bin/effect-sparql-server.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@thomasfosterau/effect-rdf": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "@thomasfosterau/effect-xml": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "catalog:peers",
    "@thomasfosterau/effect-xml": "catalog:peers",
    "effect": "catalog:platform-node-peers"
  },
  "engines": {
    "node": ">=22"
  }
}
