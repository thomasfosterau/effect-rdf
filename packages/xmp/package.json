{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-xmp",
  "version": "0.0.0",
  "description": "XMP (Extensible Metadata Platform, ISO 16684-1) packets as RDF for effect-rdf",
  "keywords": [
    "effect",
    "rdf",
    "typescript",
    "xmp"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/xmp#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/xmp"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-rdf": "workspace:*",
    "@thomasfosterau/effect-rdfxml": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-parse": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
