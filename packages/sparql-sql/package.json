{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-sparql-sql",
  "version": "0.0.0",
  "description": "A SQL storage backend for @thomasfosterau/effect-sparql (SQLite, PostgreSQL) with SPARQL-to-SQL translation, built on effect/sql",
  "keywords": [
    "effect",
    "rdf",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-rdf/tree/main/packages/sparql-sql#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-rdf/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-rdf.git",
    "directory": "packages/sparql-sql"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./*": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "catalog:",
    "@thomasfosterau/effect-rdf": "workspace:*",
    "@thomasfosterau/effect-sparql": "workspace:*"
  },
  "devDependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@thomasfosterau/effect-ntriples": "workspace:*",
    "@thomasfosterau/effect-rdfxml": "workspace:*",
    "@thomasfosterau/effect-turtle": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
