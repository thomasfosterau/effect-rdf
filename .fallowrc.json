{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/src/*.ts",
    // Core's nested subpaths (each `./<subpath>/*` export). Listed one by one so each
    // `internal/` directory stays private.
    "packages/core/src/csvw/*.ts",
    "packages/core/src/jsonld/*.ts",
    "packages/core/src/n3/*.ts",
    "packages/core/src/ntriples/*.ts",
    "packages/core/src/rdfjson/*.ts",
    "packages/core/src/rdfxml/*.ts",
    "packages/core/src/shacl/*.ts",
    "packages/core/src/shex/*.ts",
    "packages/core/src/sparql/*.ts",
    "packages/core/src/sparql/ai/*.ts",
    "packages/core/src/sparql/shacl/*.ts",
    "packages/core/src/sparql/sql/*.ts",
    "packages/core/src/turtle/*.ts",
    "packages/core/src/xmp/*.ts",
    "packages/*/test/**/*.test.ts",
    "packages/core/bench/*/*.ts",
    "packages/sparql-node/bin/*.mjs",
    "**/vite.config.ts",
    "vite.package.ts",
    "scripts/check-dist-imports.mjs"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", ".test-suites/**"],
  // The CLI bin imports the built `dist/Cli.mjs` when it exists (and the sources otherwise);
  // `dist/` is ignored above, so that runtime-optional import cannot resolve here.
  "ignoreUnresolvedImports": ["../dist/Cli.mjs"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/language-service",
    "@effect/tsgo",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@vitest/coverage-istanbul",
    "@changesets/cli",
    "@changesets/changelog-github",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/**"]
      },
      {
        "name": "sparql-node",
        "patterns": ["packages/sparql-node/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "sparql-node",
        "allow": ["core"]
      }
    ]
  },
  // Each subpath's benchmark is a standalone Node script over that subpath's
  // own corpus; sharing their timing loops would need a module that no
  // published entry point should carry.
  "duplicates": {
    "ignore": ["packages/*/bench/**"],
    // Reviewed clones that predate fallow, from when the subpaths were
    // separate packages: JSON-LD and the RDF/JSON subpath each locate JSON
    // syntax errors, the N-Triples, Turtle and RDF/XML parsers each map a
    // thrown parse failure to `RdfParseError`, and the SPARQL evaluator
    // dedupes path results the way `Dataset` dedupes terms. A content change
    // on either side makes the group reportable again.
    "ignoredClones": [
      "dup:9c54618a:2",
      "dup:ec5793a2:2",
      "dup:0a9d0de4:2",
      "dup:5c48d303:2",
      "dup:71613c48:2"
    ]
  },
  // The complexity and duplication already on `main` when fallow was adopted
  // (saved from main's sources with real coverage): the audit fails on what a
  // change adds or worsens, not on that inherited debt. Re-save a baseline
  // only to shrink it.
  "audit": {
    "healthBaseline": ".fallow-baselines/health.json",
    "dupesBaseline": ".fallow-baselines/dupes.json"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
