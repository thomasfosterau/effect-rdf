{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-rdf-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the @thomasfosterau/effect-rdf package family: an Effect-native RDF 1.2 toolkit — data model, syntaxes, SPARQL, SHACL and ShEx.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint --tsrs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
